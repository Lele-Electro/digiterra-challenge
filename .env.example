MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
# Used when no trusted browser Origin is supplied. Set to your deployed frontend in production.
RIBEIRO_APP_URL=http://localhost:4200
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=example@example.com
SMTP_PASSWORD=replace-with-an-app-password
MATLA_EMAIL_RECIPIENT=recipient@example.com
VLA_EMAIL_RECIPIENT=recipient@example.com
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://another-frontend.example.com
# Sign in with Google (OAuth 2.0 Web client ID from Google Cloud Console > Google Auth Platform > Clients)
GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com

# Optional verified sender for lift club confirmations; defaults to SMTP_USER.
RIBEIRO_EMAIL_FROM=bookings@toniribeiro.co.za


# Dedicated lift club mailbox. On Cloudflare, set these as Worker/Pages secrets.
# Leave these commented out when using the shared SMTP_* settings above instead.
# RIBEIRO_SMTP_HOST=mail.toniribeiro.co.za
# RIBEIRO_SMTP_PORT=465
# RIBEIRO_SMTP_USER=bookings@toniribeiro.co.za
# RIBEIRO_SMTP_PASSWORD=replace-with-mailbox-password
# RIBEIRO_EMAIL_FROM=bookings@toniribeiro.co.za

# Lift club booking emails. Toni's copy of each confirmed booking defaults to RIBEIRO_EMAIL_FROM.
# RIBEIRO_BOOKING_NOTIFY_TO=toni@example.com
# Permanent public host of the email images (the frontend's public/email folder).
# Defaults to https://www.toniribeiro.com/email. Never point this at a development machine.
# RIBEIRO_EMAIL_ASSETS_URL=https://www.toniribeiro.com/email
